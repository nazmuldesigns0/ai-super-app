# =================================================================
# 1. FIREBASE CONFIGURATION (Client - Public)
# =================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# =================================================================
# 2. FIREBASE ADMIN SDK (Server only - Service Account)
# =================================================================
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# =================================================================
# 3. AI MODEL PROVIDERS
# The app ships with ONLY free-tier models enabled by default.
# Add the keys below to unlock each provider's models.
# =================================================================
# Google Gemini — gemini-3.8-flash, gemini-3.5-flash-lite
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Groq Cloud — qwen/qwen3.8-27b, openai/gpt-oss-120b, openai/gpt-oss-20b
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key

# Mistral AI — codestral-latest, open-mistral-nemo, ministral-8b-latest
# Get from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key

# Cloudflare Workers AI — chat models AND free image generation/editing.
# Get from: https://dash.cloudflare.com/ (Workers AI)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# -----------------------------------------------------------------
# Optional paid providers (hidden from the UI until a key is added):
# OpenRouter, SambaNova, xAI Grok, OpenAI, Anthropic, DeepSeek,
# Hugging Face. The provider code still supports them.
# -----------------------------------------------------------------
# OPENROUTER_API_KEY=
# SAMBANOVA_API_KEY=
# GROK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# HUGGINGFACE_API_KEY=

# =================================================================
# 4. APP CONFIGURATION
# =================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =================================================================
# 5. MONITORING & ALERTS (notifications when a model/API fails)
# =================================================================
# Discord or Slack incoming webhook URL (recommended — instant alerts)
ALERT_WEBHOOK_URL=

# Email alerts via Resend (https://resend.com/api-keys)
RESEND_API_KEY=
ALERT_EMAIL_FROM=AI Monitor <onboarding@resend.dev>
ALERT_EMAIL_TO=

# Minimum gap between notifications for the same provider (ms). Default: 300000
ALERT_THROTTLE_MS=300000

# =================================================================
# 6. SECURITY
# =================================================================
# Allow the shared demo/sandbox session when no auth token is present.
# Set to "false" in production to require authentication on all APIs.
DEMO_MODE_ALLOWED=true

