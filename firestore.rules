rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helper functions ──────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    // isOwner: checks a userId field stored IN the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── Users ─────────────────────────────────────────────────────────
    // Only the user themselves (or an admin) can read/write their own doc
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── Chat Sessions ─────────────────────────────────────────────────
    // A session is readable/writable only by the user who created it
    match /chatSessions/{sessionId} {
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated()
                    && resource.data.userId == request.auth.uid;
    }

    // ── Chat Messages ─────────────────────────────────────────────────
    // Scope to messages that belong to sessions owned by current user
    // (sessionId field stored on each message document)
    match /messages/{messageId} {
      allow create: if isAuthenticated()
                    && request.resource.data.sessionId != null;
      allow read, update, delete: if isAuthenticated()
                    && exists(/databases/$(database)/documents/chatSessions/$(resource.data.sessionId))
                    && get(/databases/$(database)/documents/chatSessions/$(resource.data.sessionId)).data.userId == request.auth.uid;
    }

    // ── Library Files ─────────────────────────────────────────────────
    // A user can only see/modify their own library files
    match /libraryFiles/{fileId} {
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAuthenticated()
                    && resource.data.userId == request.auth.uid;
    }

    // ── Master Prompts ────────────────────────────────────────────────
    // Public read, admin-only write
    match /masterPrompts/{promptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Credit Transactions ───────────────────────────────────────────
    // Users can read only their own transactions; no client-side writes
    // (all writes happen via Admin SDK server-side)
    match /creditTransactions/{txId} {
      allow read: if isAuthenticated()
                  && resource.data.userId == request.auth.uid;
      allow write: if false; // Server-side Admin SDK only
    }

    // ── AI Models ─────────────────────────────────────────────────────
    // Public read, admin-only write
    match /aiModels/{modelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Verification Codes ────────────────────────────────────────────
    // E-mail verification codes: never touched from the client.
    // All reads/writes happen via the Admin SDK server-side.
    match /verificationCodes/{userId} {
      allow read, write: if false; // Server-side Admin SDK only
    }

    // ── Support Tickets ───────────────────────────────────────────────
    // Created by the support API (Admin SDK). An admin may read them;
    // users cannot read or write this collection directly.
    match /supportTickets/{ticketId} {
      allow read: if isAdmin();
      allow write: if false; // Server-side Admin SDK only
    }
  }
}
