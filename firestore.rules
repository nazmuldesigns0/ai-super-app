rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── Helper functions ──────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    // isOwner: compares the caller's uid with a userId stored IN the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── Users ─────────────────────────────────────────────────────────
    // Account documents are created and updated exclusively by the server
    // (Admin SDK) during sign-up and login. Clients may only read their own
    // profile: a user must never be able to grant themselves `role: "admin"`,
    // extra credits or a higher subscription tier from the browser.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Server-side Admin SDK only
    }

    // ── Chat Sessions ─────────────────────────────────────────────────
    // A session is readable only by the user who owns it.
    match /chatSessions/{sessionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Server-side Admin SDK only
    }

    // ── Chat Messages ─────────────────────────────────────────────────
    // Readable only when the parent session belongs to the caller.
    match /messages/{messageId} {
      allow read: if isAuthenticated()
                  && resource.data.sessionId != null
                  && exists(/databases/$(database)/documents/chatSessions/$(resource.data.sessionId))
                  && get(/databases/$(database)/documents/chatSessions/$(resource.data.sessionId)).data.userId == request.auth.uid;
      allow write: if false; // Server-side Admin SDK only
    }

    // ── Library Files ─────────────────────────────────────────────────
    // A user can only read their own library files.
    match /libraryFiles/{fileId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false; // Server-side Admin SDK only
    }

    // ── Master Prompts ────────────────────────────────────────────────
    // Public read, server-side (admin) writes only.
    match /masterPrompts/{promptId} {
      allow read: if true;
      allow write: if false; // Server-side Admin SDK only
    }

    // ── AI Models ─────────────────────────────────────────────────────
    // Public read, server-side (admin) writes only.
    match /aiModels/{modelId} {
      allow read: if true;
      allow write: if false; // Server-side Admin SDK only
    }

    // ── Credit Transactions ───────────────────────────────────────────
    // Users can read only their own transactions; no client-side writes
    // (all writes happen via the Admin SDK server-side)
    match /creditTransactions/{txId} {
      allow read: if isAuthenticated()
                  && resource.data.userId == request.auth.uid;
      allow write: if false; // Server-side Admin SDK only
    }

    // ── Verification Codes ────────────────────────────────────────────
    // E-mail verification codes: never touched from the client.
    match /verificationCodes/{userId} {
      allow read, write: if false; // Server-side Admin SDK only
    }

    // ── Support Tickets ───────────────────────────────────────────────
    // Created by the support API (Admin SDK). An admin may read them;
    // users cannot read or write this collection directly.
    match /supportTickets/{ticketId} {
      allow read: if isAdmin();
      allow write: if false; // Server-side Admin SDK only
    }

    // ── Monitoring Alerts ─────────────────────────────────────────────
    // Written by the monitoring library via the Admin SDK. Admin read only.
    match /systemAlerts/{alertId} {
      allow read: if isAdmin();
      allow write: if false; // Server-side Admin SDK only
    }
  }
}
